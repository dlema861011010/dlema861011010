# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# =============================================================================
# FuseFlash Node Configuration
# =============================================================================

# P2P Node Settings
NODE_PORT=30303
NODE_HOST=localhost
BOOTSTRAP_PEERS=

# Network Configuration
NETWORK_ID=1
CHAIN_ID=1

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL
DATABASE_URL=postgres://username:password@localhost:5432/dbname
DATABASE_MAX_CONNECTIONS=20
DATABASE_TIMEOUT=30

# Redis (for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =============================================================================
# API Keys and Secrets
# =============================================================================

# Stripe (use test keys in development)
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# AWS (if using)
# Get credentials from IAM console - never commit real keys!
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# =============================================================================
# Blockchain & Smart Contract Configuration
# =============================================================================

# Ethereum/USDC Configuration
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ETH_CHAIN_ID=1

# NEVER commit private keys - use hardware wallets or secret managers in production
# For development, use a dedicated test account with no real funds
# This is a clearly fake example - replace with your test key
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE_64_HEX_CHARACTERS

# Contract Addresses (fill after deployment)
FUSEFLASH_CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# =============================================================================
# FastAPI Bridge Configuration
# =============================================================================

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
API_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_JWT_SECRET
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Ember.js Smart Wallet Configuration
# =============================================================================

# Frontend API Endpoints
WALLET_API_URL=http://localhost:8000
WALLET_WEBSOCKET_URL=ws://localhost:8000/ws

# =============================================================================
# Logging & Monitoring
# =============================================================================

LOG_LEVEL=INFO
SENTRY_DSN=
DATADOG_API_KEY=

# =============================================================================
# Feature Flags
# =============================================================================

ENABLE_DEBUG_MODE=false
ENABLE_ANALYTICS=true
ENABLE_MAINTENANCE_MODE=false

# =============================================================================
# Security Settings
# =============================================================================

# Session
SESSION_TIMEOUT=3600
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SESSION_SECRET

# Encryption
ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_HEX_KEY

# =============================================================================
# Development & Testing
# =============================================================================

NODE_ENV=development
DEBUG=false
TESTING=false

# =============================================================================
# Docker Configuration (optional)
# =============================================================================

COMPOSE_PROJECT_NAME=fuseflash
DOCKER_REGISTRY=

# =============================================================================
# GitHub Actions Secrets (set in repository settings, not here)
# =============================================================================

# These should be set as GitHub Secrets, not in .env:
# - GITHUB_TOKEN (automatic)
# - DEPLOYMENT_KEY
# - PRODUCTION_DATABASE_URL
# - PRODUCTION_STRIPE_SECRET_KEY
# - PRODUCTION_ETH_PRIVATE_KEY (use secret manager instead!)
