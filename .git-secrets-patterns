# git-secrets patterns for FuseFlash project
# Install: https://github.com/awslabs/git-secrets

# AWS Keys
[A-Z0-9]{20}
[A-Za-z0-9/+=]{40}

# Stripe Keys
(sk|pk|rk)_(test|live)_[0-9a-zA-Z]{24,}
whsec_[0-9a-zA-Z]{32,}

# Private Keys
-----BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY-----
-----BEGIN PRIVATE KEY-----

# Ethereum Private Keys (64 hex characters)
0x[a-fA-F0-9]{64}
[a-fA-F0-9]{64}

# API Keys and Tokens
[aA][pP][iI]_?[kK][eE][yY].*['|"][0-9a-zA-Z]{32,45}['|"]
[aA][pP][iI]_?[sS][eE][cC][rR][eE][tT].*['|"][0-9a-zA-Z]{32,45}['|"]

# Generic Secrets
[sS][eE][cC][rR][eE][tT].*['|"][0-9a-zA-Z]{32,45}['|"]
[pP][aA][sS][sS][wW][oO][rR][dD].*['|"][0-9a-zA-Z]{8,45}['|"]
[tT][oO][kK][eE][nN].*['|"][0-9a-zA-Z]{32,45}['|"]

# Database URLs with credentials
(postgresql|postgres|mysql|mongodb)://[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+@
